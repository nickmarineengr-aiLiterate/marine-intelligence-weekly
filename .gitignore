# Environment variables - NEVER commit these
.env
.env.local
.env.*.local
.env.production.local

# Node
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
.next/
out/

# Python bytecode (generated by tools/pastpapers and tools/notes)
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Third-party source material. THIS REPOSITORY IS PUBLIC.
#
# Past Papers source copies are third-party-hosted scans of examination papers,
# watermarked and carrying the host's marketing. Committing them would be public
# redistribution of third-party material. The production pipeline has no runtime
# dependency on them: the structured spec is the durable input. They stay on
# disk, and out of git, deliberately.
meoclass1/pastpapers/docs/*.pdf

# Local-only provenance record. Names the third-party host of each source copy
# and the identifier printed on it. Kept off the public repository by design;
# see meoclass1/pastpapers/docs/CURRENT_STATUS.md.
meoclass1/pastpapers/verification/LOCAL_SOURCE_PROVENANCE.md

# Coaching handouts. Never a verification source, never redistributed.
Notes-for-written-answers/
